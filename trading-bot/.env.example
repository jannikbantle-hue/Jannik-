# ============ API-Keys ============
# Kopiere diese Datei zu ".env" und trage deine echten Keys ein.
# NIEMALS die echte .env committen! (siehe .gitignore)
# In der Shell laden mit:   set -a; source .env; set +a

# --- Aktien: Alpaca (https://app.alpaca.markets -> API Keys) ---
# Paper- und Live-Konto haben UNTERSCHIEDLICHE Keys.
ALPACA_API_KEY_ID=dein_alpaca_key
ALPACA_API_SECRET_KEY=dein_alpaca_secret

# --- Krypto: Kraken (https://www.kraken.com -> Settings -> API) ---
# KRAKEN_API_SECRET ist der base64-String, den Kraken dir anzeigt.
KRAKEN_API_KEY=dein_kraken_key
KRAKEN_API_SECRET=dein_kraken_secret
